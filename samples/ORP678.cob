      *--------------------------------------------------------------*  TXT22133
      *CALLING ORP039 TO LINK THE DIRECT SHIP H/WS WITH WARRANTIES      TXT22133
      *--------------------------------------------------------------*  TXT22133
       600-LINK-ORP039.                                                 TXT22133
                                                                        TXT22133
           INITIALIZE ORCO039-INPUT-AREA.                               TXT22133
           INITIALIZE ORCO039-I-MISC-AREA.                              TXT22133
           MOVE WS-LINK-ORD-CO             TO ORCO039-I-COMPANY.        TXT22133
           MOVE WS-LINK-ORD-BR             TO ORCO039-I-BR-NBR.         TXT22133
           MOVE WS-LINK-ORD-NBR            TO ORCO039-I-ORDER-NBR.      TXT22133
           MOVE WS-LINK-ORD-DIST-NBR       TO ORCO039-I-DIST-NBR.       TXT22133
           MOVE WS-LINK-ORD-SHIP-NBR       TO ORCO039-I-SHIP-NBR.       TXT22133
                                                                        TXT22133
           SET  ORCO039-I-ORDRLINK         TO TRUE.                     TXT22133
           SET  ORCO039-I-START            TO TRUE.                     TXT22133
           MOVE EIBTASKN       TO ORCO039-CHANNEL-NAME-TASK.            TXT22133
           MOVE 'ORP039'       TO ORCO039-CHANNEL-NAME-FIX.             TXT22133
           MOVE LENGTH OF ORCO039-INPUT-AREA  TO ORCO039-LENGTH.        TXT22133
                                                                        TXT22133
           EXEC CICS PUT                                                TXT22133
                 CONTAINER    ('ORCO039_INPUT')                         TXT22133
                 CHANNEL      (ORCO039-CHANNEL-NAME)                    TXT22133
                 FROM         (ORCO039-INPUT-AREA)                      TXT22133
                 FLENGTH      (LENGTH OF ORCO039-INPUT-AREA)            TXT22133
                 RESP         (WS-EIBRESP)                              TXT22133
           END-EXEC.                                                    TXT22133
                                                                        TXT22133
           IF  WS-EIB-NORESP                                            TXT22133
               NEXT SENTENCE                                            TXT22133
           ELSE                                                         TXT22133
               DISPLAY '600-  BAD PUT OF ORCO039-I, STS='  WS-EIBRESP   TXT22133
           END-IF.                                                      TXT22133
                                                                        TXT22133
      ***TERMINATE DLI BEFORE LINK TO AVOID U980 ABEND IN ORP039        TXT22133
           IF WS-DLI-SCHEDULED                                          TXT22133
              PERFORM 990-TERMINATE-DLI                                 TXT22133
           END-IF.                                                      TXT22133
                                                                        TXT22133
           IF  WS-EIB-NORESP                                            TXT22133
               EXEC CICS START                                          TXT22133
                    TRANSID      (WS-LINK-TRANSID)                      TXT22133
                    CHANNEL      (ORCO039-CHANNEL-NAME)                 TXT22133
               END-EXEC                                                 TXT22133
           END-IF.                                                      TXT22133
                                                                        TXT22133
       600-EXIT.                                                        TXT22133
           EXIT.                                                        TXT22133
      *                                                                 NXC24292
      * CALL OMP681 TO GET LIST OF ALL HOLDS FOR THE ORDER/DIST/SHIP.   NXC24292
      *                                                                 NXC24292
       7040-CALL-OMP681.                                                NXC24292
           INITIALIZE O681-ORDER-AREA.                                  NXC24292
           INITIALIZE SY777-PARM-DATA.                                  NXC24292
           INITIALIZE WS-TABLE-EMMANAGE.                                NXC24292
           MOVE ORH-COMPANY            TO O681-CO-CD.                   NXC24292
           MOVE ORH-BR-NBR             TO O681-BR-NBR.                  NXC24292
           MOVE ORH-ORDER-NBR          TO O681-ORDR-NBR.                NXC24292
           MOVE WS-ORSSHH-DIST         TO O681-DIST-NBR.                NXC24292
           MOVE WS-ORSSHH-SHIP         TO O681-SHIP-NBR.                NXC24292
           MOVE 'ORP676'               TO O681-DRIVER-PGM-NAME.         NXC24292
                                                                        NXC24292
           MOVE ORH-COMPANY            TO SY777-IN-COMPANY-CODE.        NXC24292
           MOVE ORH-ENTRY-DATE         TO SY777-IN-JUL-YYDDD.           NXC24292
           CALL 'SYU777' USING DFHEIBLK                                 NXC24292
                               DFHCOMMAREA                              NXC24292
                               SY777-PARM-DATA.                         NXC24292
                                                                        NXC24292
           IF SY777-OUT-ERR-SW  = SPACES                                NXC24292
              MOVE SY777-OUT-ISO-10    TO O681-ORDR-ENTY-DT             NXC24292
           ELSE                                                         NXC24292
              MOVE 'Z'              TO WS-R-WARN-FLAG                   NXC24292
              MOVE 'D'              TO WS-R-WARN-TYPE                   NXC24292
              PERFORM S8000-SET-WARNINGS    THRU S8000-EXIT             NXC24292
              GO TO 7040-EXIT                                           NXC24292
           END-IF.                                                      NXC24292
                                                                        NXC24292
           SET O681-I-READ             TO TRUE.                         NXC24292
           SET O681-I-LINK             TO TRUE.                         NXC24292
                                                                        NXC24292
           MOVE EIBTASKN               TO O681-CHANNEL-NAME-TASK.       NXC24292
           MOVE 'OMP681'               TO O681-CHANNEL-NAME-FIX.        NXC24292
                                                                        NXC24292
              EXEC CICS PUT                                             NXC24292
                    CONTAINER ('O681_INPUT')                            NXC24292
                    CHANNEL   (O681-CHANNEL-NAME)                       NXC24292
                    FROM      (O681-IO-AREA)                            NXC24292
                    FLENGTH   (LENGTH OF O681-IO-AREA)                  NXC24292
                    RESP      (WS-EIBRESP)                              NXC24292
              END-EXEC.                                                 NXC24292
                                                                        NXC24292
              IF WS-EIB-NORESP                                          NXC24292
                  CONTINUE                                              NXC24292
              ELSE                                                      NXC24292
               MOVE 'Z'              TO WS-R-WARN-FLAG                  NXC24292
               MOVE '4'              TO WS-R-WARN-TYPE                  NXC24292
               PERFORM S8000-SET-WARNINGS    THRU S8000-EXIT            NXC24292
               GO TO 7040-EXIT                                          NXC24292
              END-IF.                                                   NXC24292
                                                                        NXC24292
              EXEC CICS LINK                                            NXC24292
                  PROGRAM   ('OMP681')                                  NXC24292
                  CHANNEL   (O681-CHANNEL-NAME)                         NXC24292
                  RESP      (WS-EIBRESP)                                NXC24292
                  SYNCONRETURN                                          NXC24292
              END-EXEC.                                                 NXC24292
                                                                        NXC24292
              IF WS-EIB-NORESP                                          NXC24292
                  MOVE SPACES TO O681-R-RECORD-RESPONSE                 NXC24292
                  EXEC CICS GET                                         NXC24292
                        CONTAINER ('O681_OUTPUT')                       NXC24292
                        CHANNEL   (O681-CHANNEL-NAME)                   NXC24292
                        INTO      (O681-IO-AREA)                        NXC24292
                        FLENGTH   (LENGTH OF O681-IO-AREA)              NXC24292
                        RESP      (WS-EIBRESP)                          NXC24292
                  END-EXEC                                              NXC24292
                                                                        NXC24292
                  IF WS-EIB-NORESP AND O681-R-SUCCESS                   NXC24292
