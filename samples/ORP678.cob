      ******************************************************************KXS25059
      * THE FOLLOWING LOGIC IS TO IDENTIFY IF THE LINE IS GDS           KXS25059
      * IF THE LINE IS GDS, THEN IN 190- PARAGRAPH WE ARE INITIATING    KXS25059
      * A TRAN "O278(PROG ORP278)" TO CALL GPE WITH "FINALIZE" EVENT    KXS25059
      * TO COMMUNICATE THE FINALIZED LINE NUMBERS AND DISTRIBUITON      KXS25059
      * NUMBERS TO GPE. BECAUSE DURING ORDER ENTRY TIME WE DON'T HAVE   KXS25059
      * THAT INFORMATION TO COMMUNICATE TO GPE.                         KXS25059
      *                                                                 KXS25059
      * NEED NOT TO SEND FINALIZE EVENTS FOR CISCO-CCWR ORDERS,         KXS25059
      * QUOTE ORDERS AND FREE ITEMS.                                    KXS25059
      * 05  ORHOF-CISCO-ORD-SW             PIC X(01).                   KXS25059
      *     88 ORHOF-CISCO-CCWR            VALUE 'R'.                   KXS25059
      *                                                                 KXS25059
      * DIFFERENT SKUS AND THEIR RESPECTIVE LINE# INFORMATION WILL BE   KXS25059
      * SENT ALONG WITH DISTRIBUTION INFO.                              KXS25059
      *-----------------------------------------------------------------KXS25059
      * 1. NORMAL "P" TYPE LINE:                                        KXS25059
      *    EX: LINE#  SKU         COMMENT                               KXS25059
      *        001    2DM107      REQUEST WITH LINE# AS "001".          KXS25059
      *        002    3E7642      REQUEST WITH LINE# AS "002".          KXS25059
      *                                                                 KXS25059
      * 2. HARD BUNDLE:                                                 KXS25059
      *    EX: LINE#  SKU         COMMENT                               KXS25059
      *        001    HB91883056  NEED NOT TO SEND THIS LINE TO GPE     KXS25059
      *        002    AA0073      REQUEST WITH LINE# AS "002"           KXS25059
      *        003    AA0074      REQUEST WITH LINE# AS "003"           KXS25059
      *                                                                 KXS25059
      * 2. KIT COMPONENT:                                               KXS25059
      *    EX: LINE#  SKU         COMMENT                               KXS25059
      *        001    07YZ61      NEED NOT TO SEND THIS LINE TO GPE     KXS25059
      *        002    8ZQ050      REQUEST WITH LINE# AS "001" WITH      KXS25059
      *                           SYSTEM SKU AS "07YZ61"                KXS25059
      *        003    6KK873      REQUEST WITH LINE# AS "001" WITH      KXS25059
      *                           SYSTEM SKU AS "07YZ61"                KXS25059
      ****************************************************************  KXS25059
           IF OET-ADD-TO-ORDER OR ORHOF-CISCO-CCWR OR                   KXS25059
              ORSH-QUOTE-ORDER OR ORL-FREE-ITEM OR                      KXS25059
              ORL-VOIDED-LINE                                           KXS25059
              CONTINUE                                                  KXS25059
           ELSE                                                         KXS25059
              IF (ORL-OUR-PART-NBR OR                                   KXS25059
                 (ORL-COMMENT-TYPE AND                                  KXS25059
                  ORL-INV-NONSTOCK AND                                  KXS25059
                  ORL-COMPONENT-ITEM AND                                KXS25059
                  ORLOF-SYSTEM-COMPONENT))                              KXS25059
                                                                        KXS25059
                 IF (ORL-ROLL-SW = 'K' AND ORL-SYSTEMS-ITEM)            KXS25059
                 OR  ORLOF-SYSTEM-HB-MAIN-SKU                           KXS25059
                    MOVE ORL-LINE-NBR  TO WS-GDS-SYSTEM-LINE-NBR        KXS25059
                    MOVE ORL-PART-NBR  TO WS-GDS-SYSTEM-PART-NBR        KXS25059
                 ELSE                                                   KXS25059
                    IF  (ORL-COMPONENT-ITEM OR ORLOF-SYSTEM-COMPONENT)  KXS25059
                    AND (WS-GDS-SYSTEM-LINE-NBR > SPACES                KXS25059
                    AND  WS-GDS-SYSTEM-LINE-NBR =                       KXS25059
                         ORL-SYSTEM-ITEM-LINE-NBR)                      KXS25059
                         CONTINUE                                       KXS25059
                    ELSE                                                KXS25059
                         MOVE SPACES   TO WS-GDS-SYSTEM-LINE-NBR        KXS25059
                                          WS-GDS-SYSTEM-PART-NBR        KXS25059
                    END-IF                                              KXS25059
                                                                        KXS25059
      * IF THE LINE IS ALREADY ATTACHED WITH GDS ACOP OR ON "GP" HOLD   KXS25059
      * LINE CAN BE MARKED AS "GDS".THIS MAY REDUCE MOST OF THE CALLS TOKXS25059
      * VNSHED, AS INSIDELINE ORDER MOST LIKELY GET THEIR ACOPS DURING  KXS25059
      * ENTRY TIME ITSELF.                                              KXS25059
                    IF (ORL-ACOP-GDS-PART-OVRD                          KXS25059
                    OR  ORL-ACOP-GDS-VEND-OVRD                          KXS25059
                    OR  ORL-ACOP-GDS-MATRIX-OVRD                        KXS25059
                    OR  ORLOF-EU-GPE-HOLD)                              KXS25059
                         SET WS-GDS-LINE-YES TO TRUE                    KXS25059
                    END-IF                                              KXS25059
                                                                        KXS25059
      * IF THE SAME VENDOR IS READ PREVIOUSLY, CALL TO VNSHED CAN BE    KXS25059
      * SKIPPED.                                                        KXS25059
                    IF WS-GDS-LINE-NO                                   KXS25059
                       IF (ORL-VENDOR-NBR = WS-GDS-VENDOR-NBR           KXS25059
                       AND ORL-VENDOR-NBR = VNH-VENDOR-NBR              KXS25059
                       AND WS-VNSHED-NORESP)                            KXS25059
                           IF VNH-GDS-PROCESS                           KXS25059
                           OR VNH-GDS-ORD-PROCESS                       KXS25059
                              SET WS-GDS-LINE-YES TO TRUE               KXS25059
                           END-IF                                       KXS25059
                       ELSE                                             KXS25059
                           MOVE TC-COMPANY     TO WS-VNSHED-CO          KXS25059
                           MOVE 'A'            TO WS-VNSHED-CLASS       KXS25059
                           MOVE ORL-VENDOR-NBR TO WS-VNSHED-VEND        KXS25059
                                                  WS-GDS-VENDOR-NBR     KXS25059
                           PERFORM 1750-GU-VNSHED                       KXS25059
                           IF WS-VNSHED-NORESP                          KXS25059
                              IF VNH-GDS-PROCESS                        KXS25059
                              OR VNH-GDS-ORD-PROCESS                    KXS25059
                                 SET WS-GDS-LINE-YES TO TRUE            KXS25059
                              END-IF                                    KXS25059
                           END-IF                                       KXS25059
                       END-IF                                           KXS25059
                    END-IF                                              KXS25059
              END-IF                                                    KXS25059
           END-IF.                                                      KXS25059
