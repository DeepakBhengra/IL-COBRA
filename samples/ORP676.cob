927856****************************************************************  SXG03305
      *                                                                 NXC21023
      * ADDED CONDITIONS TO SKIP THE TBXCNTRY CHECK FOR UK REGION       NXC21023
      * SO THAT NO ERROR (X*) IS RETURNED FOR UK AND IE REGION.         NXC21023
      * THIS CONDITION WAS ADDED TO ELIMINATE THE CHANGES TO TBXCNTRY   NXC21023
      * TABLE WHERE ST/BT COUNTRY ARE NOT DOMESTIC TO THE REGION        NXC21023
      * PASSED DURING ORDER ENTRY. - BREXIT CHANGES                     NXC21023
      ****************************************************************  VZM23049
      * THE BELOW LOGIC IS DEFINED FOR UK AND GERMANY EXPORT ORDERS     VZM23049
      * FOR UK:                                                         VZM23049
      * IF TVAT COUNTRY CODE EQUALS SHIP-TO-COUNTRY THEN                VZM23049
      *    PLACE THE ORDER WITHOUT ANY HOLDS. DON'T FLAG AS EXPORT.     VZM23049
      * ELSE PLACE THE ORDER WITH BREXIT/EXPORT HOLDS.                  VZM23049
      * COUNTRY    JE/GG/GI ARE A PART OF UK. TO BE KEPT ON EXPORT HOLDSVZM23049
      * FOR GERMANY:                                                    VZM23049
      * CUSTOMER BRANCH 44 HAS TVAT CODE STARTING WITH DE*. CAN SHIP    VZM23049
      * CAN SHIP TO ANY LOCATION WITHIN EU AND OT COUNTRY CODE.         VZM23049
      * CUTOEMR BRANCH 15 HAS TVAT CODE OTHER THAN DE*, GENERALLY THE   VZM23049
      * BILL-TO-COUNTRY CODE VAT.                                       VZM23049
      * BILLING CNTRY IN EU == SHIPPING CNTRY IN EU                     VZM23049
      * BILLING CNTRY OUTSIDE EU == SHIPPING CNTRY SHOULD BE SAME AS    VZM23049
      * BILLING CNTRY                                                   VZM23049
      * CAN SHIP TO 'OT' COUNTRY CODE                                   VZM23049
      ****************************************************************  VZM23049
           IF  WS-EXP-BI-CNTRY-CODE = CORORA-COMPANY-CODE   AND         VZM23049
               WS-EXP-ST-CNTRY-CODE = CORORA-COMPANY-CODE               VZM23049
                CONTINUE                                                VZM23049
           ELSE                                                         VZM23049
           EVALUATE CORORA-COMPANY-CODE                                 VZM23049
             WHEN 'UK'                                                  VZM23049
              IF  WS-CUSHED-NORESP AND (NOT CU-DELETE)                  VZM23049
                MOVE SPACES             TO WS-CUM-TAX-EXEMPT-KEY        VZM23049
                MOVE 'X'                TO WS-SEGMENT-TYPE              VZM23049
                MOVE '000'              TO WS-CUM-EXEMPT-SUFFIX         VZM23049
                MOVE 'P'                TO WS-CUM-EXEMPT-TYPE           VZM23049
                MOVE WS-CUM-TAX-EXEMPT-KEY  TO WS-CUSMSC-KEY-VALUE      VZM23049
                PERFORM 1010-GU-CUSMSC                                  VZM23049
                IF  WS-CUSMSC-NORESP                                    VZM23049
                   MOVE CUM-TAX-EXEMPT-NBR TO WS-CUM-TAX-EXEMPT-NBR     VZM23049
                END-IF                                                  VZM23049
      *********   CHECK FOR SHIP TO UK                                  VZM23049
                IF (WS-CUM-TAX-EXEMPT-CC = 'GB'          AND            VZM23049
                    WS-EXP-BI-CNTRY-CODE NOT EQUAL 'UK'  AND            VZM23049
                   (WS-EXP-ST-CNTRY-CODE = 'UK' OR 'GG' OR 'JE' OR      VZM23049
                                          'GI'))                        VZM23049
                                OR                                      VZM23049
      *********   CHECK FOR SHIP TO IRELAND                             VZM23049
                   (WS-CUM-TAX-EXEMPT-CC = 'IE'  AND                    VZM23049
                    WS-EXP-BI-CNTRY-CODE NOT EQUAL 'UK'  AND            VZM23049
                   (WS-EXP-ST-CNTRY-CODE = 'IE'  OR                     VZM23049
                    CORORA-SHIP-TO-ZIP(1:4) = 'EIRE'))                  VZM23049
                                OR                                      VZM23049
      *********   CHECK FOR SHIP TO NON-EU COUNTRY WITH VAT CODE        VZM23049
                   (WS-CUM-TAX-EXEMPT-CC = WS-EXP-ST-CNTRY-CODE)        VZM23049
                       SET WS-UK-EXP-ST-INTL-ALLOWED TO TRUE            VZM23049
                END-IF                                                  VZM23049
              END-IF                                                    VZM23049
             WHEN 'DE'                                                  VZM23049
             EVALUATE CORORA-BR-NBR                                     VZM23049
                WHEN '15'                                               VZM23049
      ***** CHECK BILL-TO AND SHIP-TO IN EU                             VZM23049
                  MOVE TC-COMPANY TO TB-CNTRY-CO                        VZM23049
                  MOVE WS-EXP-BI-CNTRY-CODE TO TB-CNTRY-CODE            VZM23049
                  CALL 'SYU510' USING TB-CNTRY-TABLE-IA                 VZM23049
                  IF TB-DOMESTIC-IN-THIS-REGION                         VZM23049
                      MOVE WS-EXP-ST-CNTRY-CODE TO TB-CNTRY-CODE        VZM23049
                      CALL 'SYU510' USING TB-CNTRY-TABLE-IA             VZM23049
                      IF TB-DOMESTIC-IN-THIS-REGION                     VZM23049
                          SET WS-DE-EXP-ST-INTL-ALLOWED TO TRUE         VZM23049
                      END-IF                                            VZM23049
                  ELSE                                                  VZM23049
      ********* COMPARE SHIP-TO WITH BILL-TO AND SHIP-TO CODE OT        VZM23049
      ********* FOR BILL-TO NOT IN EU                                   VZM23049
                    IF (WS-EXP-BI-CNTRY-CODE = ('GB' OR 'UK') AND       VZM23049
                        WS-EXP-ST-CNTRY-CODE = ('GB' OR 'UK'))          VZM23049
                                   OR                                   VZM23049
                       (WS-EXP-BI-CNTRY-CODE = WS-EXP-ST-CNTRY-CODE)    VZM23049
                                   OR                                   VZM23049
                       (WS-EXP-ST-CNTRY-CODE = 'OT')                    VZM23049
                          SET WS-DE-EXP-ST-INTL-ALLOWED TO TRUE         VZM23049
                    END-IF                                              VZM23049
                  END-IF                                                VZM23049
                WHEN '44'                                               VZM23049
                  MOVE TC-COMPANY TO TB-CNTRY-CO                        VZM23049
                  MOVE WS-EXP-ST-CNTRY-CODE TO TB-CNTRY-CODE            VZM23049
                  CALL 'SYU510' USING TB-CNTRY-TABLE-IA                 VZM23049
                  IF TB-DOMESTIC-IN-THIS-REGION                         VZM23049
                     SET WS-DE-EXP-ST-INTL-ALLOWED TO TRUE              VZM23049
                  END-IF                                                VZM23049
             END-EVALUATE                                               VZM23049
             WHEN OTHER                                                 VZM23049
                SET  WS-UK-EXP-ST-INTL-NOT-ALLOWED  TO TRUE             VZM23049
                SET  WS-DE-EXP-ST-INTL-NOT-ALLOWED  TO TRUE             VZM23049
           END-EVALUATE                                                 VZM23049
           END-IF.                                                      VZM23049
