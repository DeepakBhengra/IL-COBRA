                 MOVE ORL-PART-NBR      TO WS-SAVE-PART-NBR             DXB24111
                 MOVE ORL-INV-BR-NBR    TO WS-SAVE-WHR-NBR              DXB24111
                 MOVE ORL-QTY-SHIPPED   TO WS-SAVE-QTY-SHIPPED          DXB24111
                 MOVE ' >'              TO WS-ORSLNE-SEARCH             DXB24111
                 MOVE ORL-LINE-NBR      TO WS-ORSLNE-NBR                DXB24111
                 IF WS-SAVE-PART-NBR =  WS-SIM-PART-NBR-NEW AND         DXB24111
                    (WS-SAVE-WHR-NBR =  WS-SIM-WHR-NBR-NEW  OR          DXB24111
                     WS-SIM-WHR-NBR-NEW IS EQUAL SPACES   ) AND         DXB24111
                     WS-AVAIL-QTY    >= WS-SAVE-QTY-SHIPPED             DXB24111
                       COMPUTE WS-SIM-AVAIL-QTY =                       DXB24111
                               WS-AVAIL-QTY - WS-SAVE-QTY-SHIPPED       DXB24111
