           PERFORM VARYING WS-RLSE-SUB FROM 1 BY 1                      AXS24111
                   UNTIL WS-RLSE-SUB > 50                               AXS24111
              IF O681-L-HLD-CD(WS-RLSE-SUB) = 'SP'                      AXS24111
                 MOVE 'SP' TO WS-SP-HOLD                                AXS24111
