      * CALL OMP681 TO GET LIST OF ALL HOLDS FOR THE ORDER/DIST/SHIP.   AXS24111
       952B-CALL-OMP681.                                                AXS24111
           INITIALIZE O681-ORDER-AREA                                   VZM24130
                      O681-ORDER-HOLD-AREA                              VZM24130
                      O681-LNE-AREA.                                    VZM24130
           INITIALIZE SY777-PARM-DATA.                                  AXS24111
           MOVE CORORL-COMPANY           TO O681-CO-CD.                 AXS24111
           MOVE CORORL-BR-NBR            TO O681-BR-NBR.                AXS24111
           MOVE CORORL-COMRAM-ORDER-NBR  TO O681-ORDR-NBR.              AXS24111
           MOVE CORORL-COMRAM-ORDER-DIST TO O681-DIST-NBR.              AXS24111
           MOVE CORORL-COMRAM-ORDER-SHIP TO O681-SHIP-NBR.              AXS24111
           MOVE 'ORP673'                 TO O681-DRIVER-PGM-NAME.       VZM24130
           MOVE ORH-COMPANY            TO SY777-IN-COMPANY-CODE.        AXS24111
           MOVE ORH-ENTRY-DATE         TO SY777-IN-JUL-YYDDD.           AXS24111
           CALL 'SYU777' USING DFHEIBLK                                 AXS24111
                               DFHCOMMAREA                              AXS24111
                               SY777-PARM-DATA.                         AXS24111
                                                                        AXS24111
           IF SY777-OUT-ERR-SW  = SPACES                                AXS24111
              MOVE SY777-OUT-ISO-10    TO O681-ORDR-ENTY-DT             AXS24111
           ELSE                                                         AXS24111
              SET WS-WARNINGS-ISSUED TO TRUE                            AXS24111
              MOVE 'W' TO WS-R-WARN-FLAG                                AXS24111
              MOVE '4' TO WS-R-WARN-TYPE                                AXS24111
              GO TO 952B-EXIT                                           AXS24111
           END-IF.                                                      AXS24111
                                                                        AXS24111
           SET O681-I-READ             TO TRUE.                         AXS24111
           SET O681-I-LINK             TO TRUE.                         AXS24111
                                                                        AXS24111
           MOVE EIBTASKN               TO O681-CHANNEL-NAME-TASK.       AXS24111
           MOVE 'OMP681'               TO O681-CHANNEL-NAME-FIX.        AXS24111
                                                                        AXS24111
              EXEC CICS PUT                                             AXS24111
                    CONTAINER ('O681_INPUT')                            AXS24111
                    CHANNEL   (O681-CHANNEL-NAME)                       AXS24111
                    FROM      (O681-IO-AREA)                            AXS24111
                    FLENGTH   (LENGTH OF O681-IO-AREA)                  AXS24111
                    RESP      (WS-EIBRESP)                              AXS24111
              END-EXEC.                                                 AXS24111
                                                                        AXS24111
              IF WS-EIB-NORESP                                          AXS24111
                  CONTINUE                                              AXS24111
              ELSE                                                      AXS24111
               SET WS-WARNINGS-ISSUED TO TRUE                           AXS24111
               MOVE 'W' TO WS-R-WARN-FLAG                               AXS24111
               MOVE '7' TO WS-R-WARN-TYPE                               AXS24111
               GO TO 952B-EXIT                                          AXS24111
              END-IF.                                                   AXS24111
                                                                        AXS24111
              EXEC CICS LINK                                            AXS24111
                  PROGRAM   ('OMP681')                                  AXS24111
                  CHANNEL   (O681-CHANNEL-NAME)                         AXS24111
                  RESP      (WS-EIBRESP)                                AXS24111
                  SYNCONRETURN                                          AXS24111
              END-EXEC.                                                 AXS24111
                                                                        AXS24111
              IF WS-EIB-NORESP                                          AXS24111
                  MOVE SPACES TO O681-R-RECORD-RESPONSE                 AXS24111
                  EXEC CICS GET                                         AXS24111
                        CONTAINER ('O681_OUTPUT')                       AXS24111
                        CHANNEL   (O681-CHANNEL-NAME)                   AXS24111
                        INTO      (O681-IO-AREA)                        AXS24111
                        FLENGTH   (LENGTH OF O681-IO-AREA)              AXS24111
                        RESP      (WS-EIBRESP)                          AXS24111
                  END-EXEC                                              AXS24111
                                                                        AXS24111
                  IF WS-EIB-NORESP AND O681-R-SUCCESS                   AXS24111
                     SET WS-HOLD-TBL-READY     TO TRUE                  AXS24111
                  ELSE                                                  AXS24111
                   SET WS-WARNINGS-ISSUED TO TRUE                       AXS24111
                   MOVE 'W' TO WS-R-WARN-FLAG                           AXS24111
                   MOVE '8' TO WS-R-WARN-TYPE                           AXS24111
                   GO TO 952B-EXIT                                      AXS24111
                  END-IF                                                AXS24111
              ELSE                                                      AXS24111
                SET WS-WARNINGS-ISSUED TO TRUE                          AXS24111
                MOVE 'W' TO WS-R-WARN-FLAG                              AXS24111
                MOVE '6' TO WS-R-WARN-TYPE                              AXS24111
                GO TO 952B-EXIT                                         AXS24111
              END-IF.                                                   AXS24111
                                                                        AXS24111
       952B-EXIT.                                                       AXS24111
           EXIT.                                                        AXS24111
