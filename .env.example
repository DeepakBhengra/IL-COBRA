# Copy this file to `.env` in the repository root (next to pyproject.toml).
# It is loaded automatically on startup by cobol-scan / cobol-dashboard /
# cobol-dashboard-api. Real exported environment variables take precedence.
#
# Credentials for the external lookup endpoint (POST /api/v1/lookup),
# served by the Enterprise API (cobol-dashboard-api) on http://127.0.0.1:8000.
COBOL_EXTERNAL_API_KEY=your_external_api_key_here
COBOL_EXTERNAL_APPLICATION_KEY=your_external_application_key_here

# Jira Cloud connectivity (Operational Docs -> "Jira Cloud tickets").
# Required to enable real Jira ticket search. Jira Cloud uses HTTP Basic auth
# with the account email as the username and an API token as the password
# (create one at https://id.atlassian.com/manage-profile/security/api-tokens).
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=your_atlassian_api_token
# Optional Jira settings:
# JIRA_PROJECTS=OPS,PAY                     # comma-separated project keys to scope the search
# JIRA_EXTRA_JQL=labels = cobol             # extra JQL AND-ed onto the generated query
# JIRA_MAX_RESULTS=10                       # max tickets to fetch (default 10, capped at 50)
# JIRA_SEARCH_PATH=/rest/api/3/search/jql   # use /rest/api/2/search for Jira Server/Data Center
# JIRA_MOCK=1                               # preview with built-in sample tickets (no token needed)

# Optional: OpenAI summarizer/resolver (used with --summarizer openai / --resolver openai)
# OPENAI_API_KEY=sk-...
