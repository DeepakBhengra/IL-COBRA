# Copy this file to `.env` in the repository root (next to pyproject.toml).
# It is loaded automatically on startup by cobol-scan / cobol-dashboard /
# cobol-dashboard-api. Real exported environment variables take precedence.
#
# Credentials for the external lookup endpoint (POST /api/v1/lookup),
# served by the Enterprise API (cobol-dashboard-api) on http://127.0.0.1:8000.
COBOL_EXTERNAL_API_KEY=your_external_api_key_here
COBOL_EXTERNAL_APPLICATION_KEY=your_external_application_key_here

# Optional: OpenAI summarizer/resolver (used with --summarizer openai / --resolver openai)
# OPENAI_API_KEY=sk-...
